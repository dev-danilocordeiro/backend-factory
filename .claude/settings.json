{
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push *)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/gates/**)",
      "Edit(/cmd/**)",
      "Edit(/internal/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-build.sh", "timeout": 600 }
        ]
      }
    ]
  }
}
